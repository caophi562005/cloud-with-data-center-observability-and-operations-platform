PORT=8080
LOG_LEVEL=info

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
AGENT_AUTH_CACHE_TTL_SECONDS=60

# One active Grafana Basic recipe; replace it, do not combine backend recipes.
# Exact write URL, never rewritten. HTTPS except HTTP localhost/literal loopback.
# Modes none|basic|bearer; absent/blank defaults to basic, invalid values fail.
# basic needs username + write token; bearer needs only write token;
# none ignores stale credentials and emits no Authorization. See API README recipes.
METRICS_WRITE_URL=https://YOUR-GRAFANA-METRICS-HOST/api/prom/push
METRICS_WRITE_AUTH_MODE=basic
# Shared username only for Basic directions; read/write tokens stay independent.
METRICS_USERNAME=YOUR_METRICS_TENANT_ID
METRICS_WRITE_TOKEN=YOUR_METRICS_WRITE_TOKEN
REMOTE_WRITE_TIMEOUT_SECONDS=10
REMOTE_WRITE_MAX_BODY_BYTES=10485760

RATE_LIMIT_REQUESTS_PER_SECOND=5
RATE_LIMIT_BURST=20

# Optional CLI query-back only; Gateway startup/writes do not consume these keys.
# Base URL, e.g. https://YOUR-GRAFANA-METRICS-HOST/api/prom; CLI appends /api/v1/query.
# CLI also accepts that exact endpoint/trailing slash (API requires a base instead).
# No userinfo, query strings or fragments. Same HTTPS/loopback policy as write.
# Absent/blank mode + incomplete legacy Basic query config is NOT VERIFIED.
# A nonblank explicit mode validates required fields: errors become query FAIL
# after an accepted write. Leave mode commented while URL/token below are blank.
# basic needs shared username + query token; bearer needs only query token;
# none needs URL + mode, ignores credentials. Never reuses METRICS_WRITE_TOKEN.
# METRICS_QUERY_AUTH_MODE=basic
METRICS_QUERY_URL=
METRICS_QUERY_TOKEN=
