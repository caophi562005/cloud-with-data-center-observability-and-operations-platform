NODE_ENV=development
PORT=3000
WEB_URL=http://localhost:5173

DATABASE_URL=postgresql://user:password@host/database?sslmode=require
REDIS_URL=redis://default:password@localhost:6379

# Optional: enables encrypted ENR reuse. Generate a random 32-byte hex secret;
# share the same secret across API replicas, keep outside Redis/source control.
# Missing key disables reuse safely (each Connect issues a replacement token).
# ENROLLMENT_TOKEN_CACHE_KEY=<64 hex characters>

# Telegraf monitoring is optional at startup; all three are required before use.
# API URL is an HTTPS origin (no base path); write URL is the exact HTTPS endpoint.
# No userinfo/query/fragment. Never accept endpoint overrides from monitoring UI.
# AGENT_API_PUBLIC_URL=https://api.example.invalid
# AGENT_METRICS_WRITE_URL=https://metrics.example.invalid/api/v1/write
# AGENT_MONITORING_SECRET_KEY=<64 hex characters from a random 32-byte secret>

COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=replace-with-user-pool-id
COGNITO_CLIENT_ID=replace-with-client-id
# Required for the current confidential Terraform App Client.
COGNITO_CLIENT_SECRET=replace-with-client-secret

# Optional metrics query: omit all four keys to keep querying disabled.
# Partial configuration is an error, not an optional CLI query skip.
# Base URL, NOT /api/v1/query; clients append API paths and retain base prefixes.
# HTTPS required except HTTP localhost/literal loopback; no userinfo/query/fragment.
# Mode: none|basic|bearer; absent/blank defaults to basic, invalid values fail.
# basic requires username + query token; bearer requires only query token;
# none needs only URL + mode and ignores stale credentials (no Authorization).
# Query token is independent of the write token; never a write-token fallback.
# Uncomment ONE complete recipe; alternate backends are documented in the API README.
# METRICS_QUERY_URL=https://YOUR-GRAFANA-METRICS-HOST/api/prom
# METRICS_QUERY_AUTH_MODE=basic
# METRICS_USERNAME=YOUR_METRICS_TENANT_ID
# METRICS_QUERY_TOKEN=YOUR_METRICS_READ_TOKEN

# Optional verified SNS alert ingestion; default disabled, no subscription created here.
SNS_ALERTS_ENABLED=false
# Enable only after migration/client regeneration and deployment approval.
# SNS_ALERTS_TOPIC_ARN=arn:aws:sns:ap-southeast-1:491333778094:opsgrid-dev-amp-alerts
# SNS_ALERTS_REGION=ap-southeast-1
# ECS uses task-role credentials for confirmation; never add AWS keys here.

# Optional VM health policy (defaults shown); positive percentages <=100.
# Critical must be at least every warning threshold; freshness is 1..604800 seconds.
# VM_DISCONNECTED_AFTER_SECONDS=300
# VM_HEALTH_CPU_WARNING_PERCENT=80
# VM_HEALTH_MEMORY_WARNING_PERCENT=85
# VM_HEALTH_DISK_WARNING_PERCENT=85
# VM_HEALTH_CRITICAL_PERCENT=95

# Optional: assign ADMIN to an already synchronized local user during prisma seed.
# SEED_ADMIN_COGNITO_SUB=replace-with-cognito-sub
