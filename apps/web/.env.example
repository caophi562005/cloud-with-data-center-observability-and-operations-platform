# Public URLs only; never put secrets in VITE_* variables.
# Local development: browser requests use the same-origin dev proxy.
VITE_API_URL=
# Remote agent installers always require a nonempty HTTPS API origin.
VITE_AGENT_API_URL=https://api.opsgrid.hacmieu.com

# Production: set both to HTTPS origins reachable by their respective clients.
# VITE_API_URL=https://api.opsgrid.hacmieu.com
# VITE_AGENT_API_URL=https://api.opsgrid.hacmieu.com
# If VITE_AGENT_API_URL is unset (not blank), installers fall back to VITE_API_URL.
