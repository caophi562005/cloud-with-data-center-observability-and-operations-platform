project_name    = "opsgrid"
environment     = "dev"
aws_region      = "us-east-1"

callback_urls = [
  "http://localhost:3000/auth/callback",
]

logout_urls = [
  "http://localhost:5173/login",
]

create_user_pool_domain = false
# Set true and replace the prefix with a unique value before enabling OAuth/Google.
# cognito_domain_prefix = "opsgrid-dev-change-me"

enable_google_identity_provider = false
# google_client_id     = "set-out-of-band"
# google_client_secret = "set-out-of-band"

additional_tags = {}
