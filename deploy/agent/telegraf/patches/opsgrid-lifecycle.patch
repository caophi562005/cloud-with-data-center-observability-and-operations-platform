+func (t *Telegraf) managedRun(ctx context.Context, notify func()) error {
+	return opsgrid.RunManaged(ctx, t.opsgridStateDir, func() {
+		_, _ = daemon.SdNotify(false, daemon.SdNotifyReady)
+		if notify != nil {
+			notify()
+		}
+	})
+}
+
+func (t *Telegraf) managedLoop(notify func()) error {
+	ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer cancel()
+	go func() {
+		select {
+		case <-stop:
+			cancel()
+		case <-ctx.Done():
+		}
+	}()
+	return t.managedRun(ctx, notify)
+}
