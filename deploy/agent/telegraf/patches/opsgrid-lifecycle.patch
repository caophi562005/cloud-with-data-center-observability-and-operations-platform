+// SCM Running is sent only from the coordinator's real native-ready callback.
+// Stop/Shutdown cancels the same process and waits for complete native cleanup.
+func (t *Telegraf) executeManaged(r <-chan svc.ChangeRequest, changes chan<- svc.Status) (bool, uint32) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	ready := make(chan struct{}, 1)
+	done := make(chan error, 1)
+	go func() {
+		done <- t.managedRun(ctx, func() {
+			select {
+			case ready <- struct{}{}:
+			default:
+			}
+		})
+	}()
+	stopping := false
+	for {
+		select {
+		case <-ready:
+			if !stopping {
+				changes <- svc.Status{State: svc.Running, Accepts: svc.AcceptStop | svc.AcceptShutdown}
+			}
+		case err := <-done:
+			if err != nil {
+				log.Print("E! [opsgrid-agent] MANAGED_RUNTIME_FAILED")
+				return true, 3
+			}
+			return false, windows.NO_ERROR
+		case request := <-r:
+			switch request.Cmd {
+			case svc.Interrogate:
+				changes <- request.CurrentStatus
+			case svc.Stop, svc.Shutdown:
+				stopping = true
+				changes <- svc.Status{State: svc.StopPending}
+				cancel()
+			}
+		}
+	}
+}
